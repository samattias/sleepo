{
  "name": "SleePO",
  "short_name": "SleePO",
  "description": "A chief-of-staff assistant: today, meetings, actions, replies and everything it knows.",
  "id": "/",
  "start_url": "/#/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#fafafa",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "/assets/app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/app/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Meeting prep", "url": "/#/prep" },
    { "name": "Reply drafting", "url": "/#/replies" },
    { "name": "Search", "url": "/#/search" }
  ]
}
